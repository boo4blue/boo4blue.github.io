{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "kin-account-api",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-13",
  "workers_dev": true,
  "vars": {
    "APP_ORIGIN": "https://boo4blue.github.io",
    "OWNER_EMAIL": "blueblazer82@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kin-accounts",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
